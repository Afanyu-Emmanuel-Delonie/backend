    {
      "name": "Veterinary Records",
      "item": [
        {
          "name": "Create Veterinary Record",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.environment.set('veterinaryRecordId', body.id);",
            "pm.test('resolved is false', () => pm.expect(body.resolved).to.eql(false));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"cattleId\": {{cattleId}},\n  \"visitDate\": \"2026-09-18\",\n  \"veterinarianName\": \"Dr. Amina\",\n  \"diagnosis\": \"Mastitis\",\n  \"treatment\": \"Antibiotics\",\n  \"cost\": 45.0,\n  \"followUpDate\": \"2026-09-25\"\n}"},
            "url": {"raw": "{{baseUrl}}/veterinary-records", "host": ["{{baseUrl}}"], "path": ["veterinary-records"]}
          }
        },
        {
          "name": "Get Cattle - Confirm UNDER_TREATMENT (BR-11)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('healthStatus is UNDER_TREATMENT', () => pm.expect(pm.response.json().healthStatus).to.eql('UNDER_TREATMENT'));"
          ]}}],
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/cattle/{{cattleId}}", "host": ["{{baseUrl}}"], "path": ["cattle", "{{cattleId}}"]}}
        },
        {
          "name": "Create Veterinary Record - Follow-up Before Visit (expect 422)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 422 (BR-10)', () => pm.response.to.have.status(422));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"cattleId\": {{cattleId}},\n  \"visitDate\": \"2026-09-18\",\n  \"veterinarianName\": \"Dr. Amina\",\n  \"diagnosis\": \"Mastitis\",\n  \"cost\": 10.0,\n  \"followUpDate\": \"2026-09-10\"\n}"},
            "url": {"raw": "{{baseUrl}}/veterinary-records", "host": ["{{baseUrl}}"], "path": ["veterinary-records"]}
          }
        },
        {
          "name": "Create Veterinary Record - Negative Cost (expect 400)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 400 (BR-10)', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"cattleId\": {{cattleId}},\n  \"visitDate\": \"2026-09-18\",\n  \"veterinarianName\": \"Dr. Amina\",\n  \"diagnosis\": \"Mastitis\",\n  \"cost\": -5.0\n}"},
            "url": {"raw": "{{baseUrl}}/veterinary-records", "host": ["{{baseUrl}}"], "path": ["veterinary-records"]}
          }
        },
        {
          "name": "Get All Veterinary Records",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/veterinary-records", "host": ["{{baseUrl}}"], "path": ["veterinary-records"]}}
        },
        {
          "name": "Get Veterinary Record By Id",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/veterinary-records/{{veterinaryRecordId}}", "host": ["{{baseUrl}}"], "path": ["veterinary-records", "{{veterinaryRecordId}}"]}}
        },
        {
          "name": "Update Veterinary Record",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"cattleId\": {{cattleId}},\n  \"visitDate\": \"2026-09-18\",\n  \"veterinarianName\": \"Dr. Amina\",\n  \"diagnosis\": \"Mastitis (confirmed)\",\n  \"treatment\": \"Antibiotics + rest\",\n  \"cost\": 50.0,\n  \"followUpDate\": \"2026-09-25\"\n}"},
            "url": {"raw": "{{baseUrl}}/veterinary-records/{{veterinaryRecordId}}", "host": ["{{baseUrl}}"], "path": ["veterinary-records", "{{veterinaryRecordId}}"]}
          }
        },
        {
          "name": "Resolve Veterinary Record (BR-11)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('resolved is true', () => pm.expect(pm.response.json().resolved).to.eql(true));"
          ]}}],
          "request": {"method": "PATCH", "url": {"raw": "{{baseUrl}}/veterinary-records/{{veterinaryRecordId}}/resolve", "host": ["{{baseUrl}}"], "path": ["veterinary-records", "{{veterinaryRecordId}}", "resolve"]}}
        },
        {
          "name": "Get Cattle - Confirm RECOVERED (BR-11)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('healthStatus is RECOVERED', () => pm.expect(pm.response.json().healthStatus).to.eql('RECOVERED'));"
          ]}}],
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/cattle/{{cattleId}}", "host": ["{{baseUrl}}"], "path": ["cattle", "{{cattleId}}"]}}
        },
        {
          "name": "Resolve Veterinary Record Again (expect 422)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 422', () => pm.response.to.have.status(422));"
          ]}}],
          "request": {"method": "PATCH", "url": {"raw": "{{baseUrl}}/veterinary-records/{{veterinaryRecordId}}/resolve", "host": ["{{baseUrl}}"], "path": ["veterinary-records", "{{veterinaryRecordId}}", "resolve"]}}
        },
        {
          "name": "Delete Veterinary Record",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/veterinary-records/{{veterinaryRecordId}}", "host": ["{{baseUrl}}"], "path": ["veterinary-records", "{{veterinaryRecordId}}"]}}
        }
      ]
    },
