        },
        {
          "name": "Get Milk Production By Cattle",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/milk-productions?cattleId={{cattleId}}", "host": ["{{baseUrl}}"], "path": ["milk-productions"], "query": [{"key": "cattleId", "value": "{{cattleId}}"}]}}
        },
        {
          "name": "Get Milk Production By Id",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
