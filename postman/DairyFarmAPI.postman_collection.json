          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 404 (BR-03)', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"cattleId\": 999999,\n  \"recordDate\": \"2026-09-19\",\n  \"shift\": \"EVENING\",\n  \"quantityLiters\": 10\n}"},
            "url": {"raw": "{{baseUrl}}/milk-productions", "host": ["{{baseUrl}}"], "path": ["milk-productions"]}
          }
