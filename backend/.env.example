# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored — never commit real secrets.

# --- JWT ---
# Required. Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional. Access token lifetime in milliseconds (default: 24h)
JWT_EXPIRATION_MS=86400000

# --- Email (SMTP) ---
# For Gmail: generate a 16-character App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Do NOT use your normal account password.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- One-time codes ---
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
PASSWORD_RESET_EXPIRATION_MINUTES=15

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (optional override; see docker-compose.yml for defaults) ---
# DB_URL=jdbc:postgresql://localhost:5432/dairy_farm_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
