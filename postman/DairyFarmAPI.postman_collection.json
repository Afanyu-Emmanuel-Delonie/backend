{
  "info": {
    "name": "Dairy Farm Management API",
    "description": "CRUD and business-rule test collection for Cattle, Milk Production and Veterinary Records (Spring Boot REST API).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cattle",
      "item": [
        {
          "name": "Create Cattle",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.environment.set('cattleId', body.id);",
            "pm.test('has tagNumber', () => pm.expect(body.tagNumber).to.eql('COW-001'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tagNumber\": \"COW-001\",\n  \"breed\": \"Holstein\",\n  \"dateOfBirth\": \"2022-01-15\",\n  \"healthStatus\": \"HEALTHY\"\n}"},
            "url": {"raw": "{{baseUrl}}/cattle", "host": ["{{baseUrl}}"], "path": ["cattle"]}
          }
        },
        {
          "name": "Create Cattle - Duplicate Tag (expect 409)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 409 Conflict (BR-01)', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tagNumber\": \"COW-001\",\n  \"breed\": \"Jersey\",\n  \"dateOfBirth\": \"2022-01-15\",\n  \"healthStatus\": \"HEALTHY\"\n}"},
            "url": {"raw": "{{baseUrl}}/cattle", "host": ["{{baseUrl}}"], "path": ["cattle"]}
          }
        },
        {
          "name": "Create Cattle - Invalid Tag Format (expect 400)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 400 (BR-07)', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tagNumber\": \"!!\",\n  \"breed\": \"Jersey\",\n  \"dateOfBirth\": \"2022-01-15\",\n  \"healthStatus\": \"HEALTHY\"\n}"},
            "url": {"raw": "{{baseUrl}}/cattle", "host": ["{{baseUrl}}"], "path": ["cattle"]}
          }
        },
        {
          "name": "Create Cattle - Future Birth Date (expect 400)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 400 (BR-02)', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tagNumber\": \"COW-999\",\n  \"breed\": \"Jersey\",\n  \"dateOfBirth\": \"2099-01-01\",\n  \"healthStatus\": \"HEALTHY\"\n}"},
            "url": {"raw": "{{baseUrl}}/cattle", "host": ["{{baseUrl}}"], "path": ["cattle"]}
          }
        },
        {
          "name": "Get All Cattle",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/cattle", "host": ["{{baseUrl}}"], "path": ["cattle"]}}
        },
        {
          "name": "Get Cattle By Id",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/cattle/{{cattleId}}", "host": ["{{baseUrl}}"], "path": ["cattle", "{{cattleId}}"]}}
        },
        {
          "name": "Get Cattle By Id - Not Found (expect 404)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/cattle/999999", "host": ["{{baseUrl}}"], "path": ["cattle", "999999"]}}
        },
        {
          "name": "Update Cattle",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('breed updated', () => pm.expect(pm.response.json().breed).to.eql('Holstein-Friesian'));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tagNumber\": \"COW-001\",\n  \"breed\": \"Holstein-Friesian\",\n  \"dateOfBirth\": \"2022-01-15\",\n  \"healthStatus\": \"HEALTHY\"\n}"},
            "url": {"raw": "{{baseUrl}}/cattle/{{cattleId}}", "host": ["{{baseUrl}}"], "path": ["cattle", "{{cattleId}}"]}
          }
        }
      ]
    },
    {
